{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (CYBER-FROST)",
      "options": {
        "baseURL": "http://100.78.93.11:8080/v1",
        "apiKey": "{env:STRATA_API_KEY}"
      },
      "models": {
        "cyber-frost-3.8-q3_k_m": {
          "name": "CYBER-FROST 3.8 Q3_K_M",
          "tool_call": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "model": "strata/cyber-frost-3.8-q3_k_m",
  "permission": {
    "bash": {
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git branch -D*": "ask",
      "sudo *": "ask",
      "wrangler deploy*": "ask",
      "vercel deploy*": "ask",
      "npm publish*": "ask",
      "kubectl delete*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask"
    }
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [".js", ".ts", ".tsx", ".vue"]
    }
  },
  "agent": {
    "reviewer": {
      "description": "Code review agent with read-only permissions for analyzing code quality",
      "mode": "subagent",
      "prompt": "You are a code reviewer specialized in analyzing code quality, best practices, security vulnerabilities, and potential bugs. You can read files, search code patterns using glob and grep, and provide detailed feedback. You cannot modify files.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      },
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
